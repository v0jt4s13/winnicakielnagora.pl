# Przykladowe zmienne srodowiskowe — winnicakielnagora.pl
#
# Skopiuj do `.env` i wypelnij prawdziwymi wartosciami: `cp .env.example .env`.
# `.env.example` NIE zawiera zadnych sekretow i wolno go commitowac; `.env`
# NIGDY (patrz .gitignore i .ai/GUARDRAILS.md -> STOP #1 — sekrety nigdy do repo).
#
# Nic w tym repo nie wczytuje `.env` automatycznie (brak python-dotenv) — to
# wylacznie dokumentacja kontraktu. Zmienne trzeba faktycznie ustawic w srodowisku:
#   lokalnie:    set -a; source .env; set +a   (przed uruchomieniem dev-server.py)
#   produkcyjnie: konfiguracja uslugi systemd (Environment=/EnvironmentFile=),
#                 przez projects_manager — i PAMIETAJ zrestartowac proces po zmianie,
#                 samo ustawienie zmiennej nie wystarczy, jesli gunicorn juz dziala.

# --- Panel redakcyjny (produkcja, za HTTP Basic Auth) -----------------------
# Bez OBU tych zmiennych panel jest wylaczony i /tools/panel/... zwraca 404,
# nie 401 — brak konfiguracji nie moze zdradzic, ze panel w ogole istnieje.
PANEL_UZYTKOWNIK=

# Hash generuje `python3 tools/panel/haslo.py` — haslo NIGDY nie trafia do repo
# ani do tego pliku, tylko wygenerowany hash w formacie sol:hash.
PANEL_HASLO_HASH=

# --- Formularz kontaktowy: zabezpieczenie (CAPTCHA) -------------------------
# Wymagane, zeby /api/contact/challenge dzialalo. Bez niego endpoint zwraca 503,
# a strona pokazuje "Nie udalo sie przygotowac zabezpieczenia. Odswiez strone."
# Losowy ciag min. 32 znaki, wygeneruj wlasny:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CONTACT_CAPTCHA_SECRET=

# --- Formularz kontaktowy: wysylka SMTP --------------------------------------
# Te trzy sa wymagane, zeby /api/contact moglo faktycznie wyslac wiadomosc.
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_TO=kielnarowagora@gmail.com
CONTACT_FROM=kielnarowagora@gmail.com

# Opcjonalne — domyslnie 587 (STARTTLS).
CONTACT_SMTP_PORT=587

# Para opcjonalna, ale musi wystapic razem (albo obie puste, albo obie ustawione).
# Dla Gmaila: adres konta + HASLO APLIKACJI (16 znakow, wymaga wlaczonej
# weryfikacji dwuetapowej na koncie) — NIGDY zwykle haslo do konta Google.
# Od 2026-09-11 wygodniej ustawic to z panelu redakcyjnego (sekcja "Konfiguracja
# poczty") — dane z panelu maja pierwszenstwo przed tymi dwiema zmiennymi, gdy
# istnieja. Zmienne zostaja jako fallback / sposob konfiguracji bez dostepu do panelu.
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=

# Gdzie panel zapisuje dane logowania SMTP (patrz wyzej) — plik z prawami 0600,
# POZA katalogiem wdrozenia, ten sam uklad co CENNIK_SCIEZKA/WYDARZENIA_SCIEZKA.
# Bez tej zmiennej ladują lokalnie do data/ (gitignorowane, bezpieczne dla dev).
CONTACT_SMTP_SCIEZKA=

# 1/true/yes -> SMTP_SSL (zwykle port 465). Zostaw puste albo 0 dla STARTTLS na 587.
CONTACT_SMTP_SSL=0

# --- Sciezki zywych danych (poza katalogiem wdrozenia) ----------------------
# Bez nich panel czyta/zapisuje data/wina.json i data/wydarzenia.json wprost
# w katalogu repo — dobre lokalnie, zle na produkcji (kolejny deploy nadpisalby
# zmiany zrobione panelem). Patrz TODO.md #26.
CENNIK_SCIEZKA=
WYDARZENIA_SCIEZKA=

# --- Routing za reverse proxy ------------------------------------------------
# Ustaw wylacznie, jesli proxy NIE obcina samo przedrostka sciezki (i nie
# wysyla poprawnego SCRIPT_NAME). W wiekszosci konfiguracji zostaje puste.
SCIEZKA_BAZOWA=

# --- Wylacznie lokalny dev-server (tools/dev-server.py) ----------------------
# Oba opcjonalne — argumenty --host/--port maja pierwszenstwo nad tymi zmiennymi.
HOST=127.0.0.1
PORT=5000

# --- Wylacznie lokalny panel (tools/panel/serwer.py) — pomocnik opisu AI ----
# Panel produkcyjny (wsgi.py) NIGDY tego nie uzywa — patrz .ai/GUARDRAILS.md,
# "tools/ nie moze byc importowane przez wsgi.py". Bez klucza przycisk
# "Przygotuj opis" w panelu po prostu nie dziala, reszta panelu jest nietknieta.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
